{
    "app-id": "app.drey.Damask",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "damask",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "modules": [
        {
            "name": "libportal",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbackend-gtk4=enabled",
                "-Dbackend-gtk3=disabled",
                "-Ddocs=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flatpak/libportal",
                    "tag": "0.9.1",
                    "commit": "8f5dc8d192f6e31dafe69e35219e3b707bde71ce"
                }
            ]
        },
        {
            "name": "damask",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Dnasa_api_key=4pL9uuwf0xoBgvT9EJsbZh3xj2ucbfsIhXWXfzTc"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/subpop/damask.git",
                    "tag": "v0.3.2",
                    "commit": "e60d4ff8f35888369dc0f97ac8cdf480c8fbcd72"
                }
            ]
        }
    ]
}
